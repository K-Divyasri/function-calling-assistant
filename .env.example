# Copy this file to ".env" and add a key ONLY if you want the --real flag (a
# genuine LLM choosing the tools). Everything else runs offline with no key.
#
# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Other providers work too via LiteLLM — set the matching key and pass
# --model claude-sonnet-5  /  --model openai/gpt-4o-mini  etc.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
